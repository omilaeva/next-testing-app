"use client";

import React, { useState } from "react";
import { FaSearch, FaPlus } from "react-icons/fa";

const segments = [
  { label: "All Customers", count: null },
  { label: "Enterprise", count: 48 },
  { label: "Mid-Market", count: 64 },
  { label: "Small Business", count: 40 },
  { label: "Trial", count: 7 },
];

const CustomerFilter: React.FC = () => {
  const [activeSegment, setActiveSegment] = useState<string>("All Customers");
  const [searchTerm, setSearchTerm] = useState<string>("");

  return (
    <div className="flex flex-col space-y-4">
      {/* Segments */}
      <div className="flex items-center space-x-6 border-b pb-2">
        {segments.map(({ label, count }) => (
          <button
            key={label}
            onClick={() => setActiveSegment(label)}
            className={`relative text-sm font-medium transition-all duration-200 focus:outline-none 
              ${activeSegment === label ? "text-black border-b-2 border-black" : "text-gray-500"}
              hover:text-black`}
            aria-pressed={activeSegment === label}
          >
            {label}
            {count !== null && (
              <span className="ml-1 px-2 py-0.5 text-xs font-semibold text-gray-600 bg-gray-200 rounded-full">
                {count}
              </span>
            )}
          </button>
        ))}
      </div>

      {/* Filters & Search */}
      <div className="flex items-center space-x-4">
        {/* Search Input */}
        <div className="relative flex-1">
          <input
            type="text"
            placeholder="Search customers..."
            className="w-full pl-10 pr-4 py-2 text-sm border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            aria-label="Search customers"
          />
          <FaSearch className="absolute left-3 top-2.5 text-gray-400" />
        </div>

        {/* Status Dropdown */}
        <select
          className="p-2 text-sm border rounded-md bg-white focus:ring-2 focus:ring-blue-500"
          aria-label="Filter by status"
        >
          <option>All Statuses</option>
          <option>Active</option>
          <option>Inactive</option>
          <option>Trial</option>
        </select>

        {/* Plan Dropdown */}
        <select
          className="p-2 text-sm border rounded-md bg-white focus:ring-2 focus:ring-blue-500"
          aria-label="Filter by plan"
        >
          <option>All Plans</option>
          <option>Enterprise</option>
          <option>Professional</option>
          <option>Standard</option>
        </select>

        {/* Add Customer Button */}
        <button
          className="flex items-center px-4 py-2 text-sm font-medium text-white bg-[#003366] rounded-md hover:bg-blue-800 transition"
          aria-label="Add Customer"
        >
          <FaPlus className="mr-2" />
          Add Customer
        </button>
      </div>
    </div>
  );
};

export default CustomerFilter;



